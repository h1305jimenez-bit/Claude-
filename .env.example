# ---- Revolut ----
# Your Revolut.me username (without @). Payments are sent here.
# Default matches the current HEC team account.
NEXT_PUBLIC_REVOLUT_USERNAME=hecparis2026

# ---- Auth ----
# A long random string used to sign session, OTP and admin tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string

# Password for the operator dashboard at /admin/orders.
# Pick something strong — anyone with this password sees every order.
ADMIN_PASSWORD=change-me-admin-password

# ---- Email (Resend) ----
# Sign up free at https://resend.com, create an API key in the dashboard.
# Without this key, the app prints login codes in the server console instead
# of sending real emails (handy for local dev).
RESEND_API_KEY=
# The "From" address for all emails. Use the default onboarding address until
# you verify your own domain in Resend. Must be a verified sender in prod.
RESEND_FROM="HEC Campus Delivery <onboarding@resend.dev>"
# Every incoming order is emailed to this address (the operator's inbox).
# Defaults to h_1305@hotmail.com — override if someone else handles orders.
OPERATOR_EMAIL=h_1305@hotmail.com

# ---- WhatsApp (CallMeBot) ----
# Free service that sends a WhatsApp message to YOUR phone when a new order
# comes in. Setup is a 2-minute one-time thing — see README.
# Phone number in international format WITHOUT "+" or spaces.
# Example below is +52 55 3466 0384 (Mexico).
CALLMEBOT_PHONE=525534660384
# API key that CallMeBot sent you when you authorized it.
CALLMEBOT_API_KEY=
