# Telovendo — variables de entorno
# La Fase 1 (MVP) NO requiere ninguna de estas: corre con localStorage.
# Estas quedan documentadas para las siguientes fases.

# ---- IA (Claude) — Fase de IA ----
# API key de Anthropic para generar el contenido del sitio.
# Sin esta key, el wizard usa el generador demo.
ANTHROPIC_API_KEY=

# ---- Supabase — Fase 2 (datos + auth) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Mercado Pago — Fase 3 (pagos) ----
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# ---- Dominio ----
NEXT_PUBLIC_APP_URL=https://telovendo.mx
