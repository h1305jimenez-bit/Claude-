# ---- Supabase ----
# Project URL and anon key — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key (bypasses RLS — server-side only, never expose to the browser)
# Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Anthropic (Claude) ----
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ---- Adzuna (job search — 18 countries) ----
# Free registration at developer.adzuna.com → My Apps
ADZUNA_APP_ID=your-app-id
ADZUNA_API_KEY=your-app-key

# ---- SerpAPI (Google Jobs — worldwide coverage) ----
# serpapi.com → Dashboard → API Key
# Free: 100 searches/month. Basic plan ($50/mo): 5,000 searches/month
SERPAPI_KEY=your-serpapi-key

# ---- Stripe ----
# dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
# dashboard.stripe.com → Developers → Webhooks → Add endpoint
# URL: https://your-domain.com/api/stripe/webhook
# Events: customer.subscription.created, customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- App URL ----
# Your production domain — used for Stripe success/cancel redirects
NEXT_PUBLIC_URL=https://your-app.vercel.app
