# ---- Supabase ----
# Project URL and anon key from https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key (bypasses RLS — server-side only, never expose to browser)
SUPABASE_SERVICE_KEY=your-service-role-key

# ---- Anthropic (Claude) ----
# API key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ---- Adzuna (job search) ----
# Free API from https://developer.adzuna.com — App ID + App Key
ADZUNA_APP_ID=your-app-id
ADZUNA_API_KEY=your-app-key

# ---- Stripe ----
# Keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook secret from https://dashboard.stripe.com/webhooks (after creating endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID for the $9/month Pro plan (create in Stripe Dashboard → Products)
STRIPE_PRO_PRICE_ID=price_...
